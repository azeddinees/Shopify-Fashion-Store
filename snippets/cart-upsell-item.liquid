{% doc %}
  Renders a cart upsell product row for the cart drawer or cart page.

  Pass a product, or rely on the theme setting `cart_upsell_product`.
  Hidden when the product is blank, unavailable, or already in the cart.

  @param {product} [product] - Optional upsell product; falls back to theme setting

  @example
  {% render 'cart-upsell-item' %}
  {% render 'cart-upsell-item', product: collections['complete-the-look'].products.first %}
{% enddoc %}

{% liquid
  assign upsell_product = product
  if upsell_product == blank
    assign upsell_product = settings.cart_upsell_product
  endif

  assign upsell_variant = upsell_product.selected_or_first_available_variant
  assign already_in_cart = false
  assign upsell_image_alt = upsell_product.title

  if upsell_product != blank and upsell_product.featured_image.alt != blank
    assign upsell_image_alt = upsell_product.featured_image.alt
  endif

  if upsell_product != blank
    for item in cart.items
      if item.product_id == upsell_product.id
        assign already_in_cart = true
        break
      endif
    endfor
  endif
%}

{% if upsell_product != blank and upsell_product.available and upsell_variant != blank and already_in_cart == false %}
  <cart-upsell-item
    class="cart-upsell"
    data-variant-id="{{ upsell_variant.id }}"
  >
    <div class="cart-upsell__media">
      {% if upsell_product.featured_image %}
        {{
          upsell_product.featured_image
          | image_url: width: 240
          | image_tag:
            widths: '60, 120, 180, 240',
            sizes: '60px',
            loading: 'lazy',
            width: 60,
            height: 60,
            class: 'cart-upsell__image',
            alt: upsell_image_alt
        }}
      {% endif %}
    </div>

    <div class="cart-upsell__details">
      <a class="cart-upsell__title" href="{{ upsell_product.url }}">
        {{ upsell_product.title | escape }}
      </a>
      <p class="cart-upsell__price">{{ upsell_variant.price | money }}</p>

      <form
        class="cart-upsell__form"
        action="{{ routes.cart_add_url }}"
        method="post"
        data-cart-upsell-form
      >
        <input type="hidden" name="id" value="{{ upsell_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button
          type="submit"
          class="cart-upsell__button"
          data-cart-upsell-add
        >
          {{ 'cart.upsell_add' | t }}
        </button>
      </form>
    </div>
  </cart-upsell-item>
{% endif %}

{% stylesheet %}
  .cart-upsell {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-top: 1px solid color-mix(in srgb, var(--color-foreground) 15%, transparent);
    color: var(--color-foreground);
  }

  .cart-upsell__media {
    flex-shrink: 0;
    width: 60px;
    height: 60px;
    overflow: hidden;
    border-radius: var(--style-border-radius-inputs);
    background-color: color-mix(in srgb, var(--color-foreground) 6%, var(--color-background));
  }

  .cart-upsell__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-upsell__details {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    flex: 1;
  }

  .cart-upsell__title {
    color: inherit;
    text-decoration: none;
    font-weight: 500;
    line-height: 1.3;
  }

  .cart-upsell__title:hover {
    text-decoration: underline;
  }

  .cart-upsell__price {
    margin: 0;
    font-size: 0.9375rem;
    color: color-mix(in srgb, var(--color-foreground) 75%, transparent);
  }

  .cart-upsell__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5rem 0.875rem;
    margin-top: 0.25rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 25%, transparent);
    border-radius: var(--style-border-radius-inputs);
    background: transparent;
    color: var(--color-foreground);
    font: inherit;
    cursor: pointer;
  }

  .cart-upsell__button:hover {
    border-color: var(--color-foreground);
  }

  .cart-upsell__button[aria-busy='true'] {
    opacity: 0.6;
    pointer-events: none;
  }
{% endstylesheet %}

{% javascript %}
  class CartUpsellItem extends HTMLElement {
    connectedCallback() {
      this.form = this.querySelector('[data-cart-upsell-form]');
      this.button = this.querySelector('[data-cart-upsell-add]');
      this.form?.addEventListener('submit', this.#onSubmit);
    }

    disconnectedCallback() {
      this.form?.removeEventListener('submit', this.#onSubmit);
    }

    #onSubmit = async (event) => {
      event.preventDefault();
      if (!this.form || !this.button) return;

      const formData = new FormData(this.form);
      const id = Number(formData.get('id'));
      const quantity = Number(formData.get('quantity') || 1);

      this.button.setAttribute('aria-busy', 'true');
      this.button.disabled = true;

      try {
        if (window.CartAjax?.addItem) {
          await window.CartAjax.addItem(id, { quantity });
        } else {
          const response = await fetch(`${window.Shopify?.routes?.root || '/'}cart/add.js`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ items: [{ id, quantity }] }),
          });
          if (!response.ok) throw new Error('Add to cart failed');
          document.documentElement.dispatchEvent(
            new CustomEvent('cart:updated', {
              bubbles: true,
              detail: { source: 'cart-upsell-item', variantId: id },
            })
          );
        }
        this.hidden = true;
      } catch (error) {
        this.button.disabled = false;
        this.button.removeAttribute('aria-busy');
        this.form.submit();
      }
    };
  }

  if (!customElements.get('cart-upsell-item')) {
    customElements.define('cart-upsell-item', CartUpsellItem);
  }
{% endjavascript %}
