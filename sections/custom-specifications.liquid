{% liquid
  assign key_ingredients = product.metafields.custom.key_ingredients
  assign has_ingredients = false
  if key_ingredients != blank
    assign has_ingredients = true
  endif

  assign has_blocks = false
  for block in section.blocks
    if block.settings.title != blank or block.settings.content != blank
      assign has_blocks = true
      break
    endif
  endfor
%}

{% if has_ingredients or has_blocks %}
  <div
    class="custom-specs"
    style="
      --custom-specs-padding-block-start: {{ section.settings.padding_top }}px;
      --custom-specs-padding-block-end: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="custom-specs__inner">
      {% if section.settings.heading != blank %}
        <h2 class="custom-specs__title">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      <div class="custom-specs__accordion">
        {% if has_ingredients %}
          <details
            class="custom-specs__item"
            {% if section.settings.open_first %}
              open
            {% endif %}
          >
            <summary class="custom-specs__summary">
              <span class="custom-specs__label">
                {{ section.settings.metafield_label | default: 'Active Ingredients' | escape }}
              </span>
              <span class="custom-specs__icon" aria-hidden="true"></span>
            </summary>
            <div class="custom-specs__content">
              {{ key_ingredients | metafield_tag }}
            </div>
          </details>
        {% endif %}

        {% for block in section.blocks %}
          {% liquid
            assign block_title = block.settings.title
            assign block_content = block.settings.content
            if block_title == blank and block_content == blank
              continue
            endif

            assign open_block = false
            if section.settings.open_first and has_ingredients == false and forloop.first
              assign open_block = true
            endif
          %}
          <details
            class="custom-specs__item"
            {% if open_block %}
              open
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="custom-specs__summary">
              <span class="custom-specs__label">{{ block_title | escape }}</span>
              <span class="custom-specs__icon" aria-hidden="true"></span>
            </summary>
            <div class="custom-specs__content">
              {{ block_content }}
            </div>
          </details>
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .custom-specs {
    padding-block-start: var(--custom-specs-padding-block-start, 0);
    padding-block-end: var(--custom-specs-padding-block-end, 0);
  }

  .custom-specs__inner {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .custom-specs__inner > * {
    grid-column: 2;
    width: min(100%, 40rem);
    margin-inline: auto;
  }

  .custom-specs__title {
    font-family: var(--font-primary--family);
    font-size: 1.75rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    text-align: center;
    color: var(--color-foreground);
  }

  .custom-specs__item {
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 15%, transparent);
  }

  .custom-specs__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 44px;
    padding-block: 0.75rem;
    cursor: pointer;
    list-style: none;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--color-foreground);
  }

  .custom-specs__summary::-webkit-details-marker {
    display: none;
  }

  .custom-specs__icon {
    position: relative;
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
  }

  .custom-specs__icon::before,
  .custom-specs__icon::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 100%;
    height: 2px;
    background-color: currentColor;
    transform: translate(-50%, -50%);
    transition: transform 0.2s ease;
  }

  .custom-specs__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .custom-specs__item[open] .custom-specs__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .custom-specs__content {
    margin-block-end: 0.75rem;
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
    line-height: 1.6;
  }

  .custom-specs__content > *:first-child {
    margin-block-start: 0;
  }

  .custom-specs__content > *:last-child {
    margin-block-end: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product_specifications",
  "tag": "section",
  "class": "section-custom-specifications",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Specifications & Details"
    },
    {
      "type": "text",
      "id": "metafield_label",
      "label": "t:labels.ingredients_label",
      "default": "Active Ingredients",
      "info": "t:info.key_ingredients_metafield"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "t:labels.open_first_row",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "spec_item",
      "name": "t:general.spec_item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Shipping & Handling"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:labels.content",
          "default": "<p>Standard delivery takes 2-4 business days.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.product_specifications",
      "blocks": [{ "type": "spec_item" }]
    }
  ]
}
{% endschema %}
